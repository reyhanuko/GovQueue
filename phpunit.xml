<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
            <exclude>tests/Feature/BookingConcurrencyTest.php</exclude>
        </testsuite>
        <testsuite name="Concurrency">
            <file>tests/Feature/BookingConcurrencyTest.php</file>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Tests run against MySQL (govqueue_test), not SQLite: the Sprint 3
             capacity tests rely on real SELECT ... FOR UPDATE row locking,
             which SQLite does not implement and would silently ignore. -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="govqueue_test"/>
        <env name="DB_USERNAME" value="root"/>
        <env name="DB_PASSWORD" value=""/>
        <!-- Must NOT be "null" here. The null broadcaster's auth() returns
             nothing, so every channel-authorisation test silently passed
             against a driver that checks nothing. Reverb's auth path only needs
             the app key/secret to sign a response, so no server is required. -->
        <env name="BROADCAST_CONNECTION" value="reverb"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
