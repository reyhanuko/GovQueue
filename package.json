{
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "concurrently --names \"vite,mail\" --prefix-colors \"blue,green\" \"vite\" \"npm run mail\"",
        "mail": "%USERPROFILE%\\mailpit\\mailpit.exe --smtp 127.0.0.1:2525 --listen 127.0.0.1:8025",
        "test:browser": "playwright test",
        "browser:setup": "node scripts/setup-browser-env.js",
        "serve:browser": "node -e \"require('fs').rmSync('public/hot',{force:true})\" && php artisan serve --env=browser --host=127.0.0.1 --port=8123"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.0",
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.7.4",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^1.2.0",
        "tailwindcss": "^4.0.0",
        "vite": "^6.0.11"
    },
    "dependencies": {
        "laravel-echo": "^2.5.0",
        "pusher-js": "^8.6.0"
    }
}
